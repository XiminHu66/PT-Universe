# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/data/*.db
/data/*.db-*
/data/

# runtime output, snapshots, backups and deployment artifacts
# Keep these out of the public repository; ignoring is not deletion.
*.db
*.db-wal
*.db-shm
*.tar.gz
/deployment-backups/
/reports/
/snapshots/
*.bak
*.log
latest.json
rounds/*.json

# IDE-local launch config; not part of the published project.
/.mrdayone/

# local agent memory and workspace metadata
/.workbuddy/

# local API secrets
.secrets/
