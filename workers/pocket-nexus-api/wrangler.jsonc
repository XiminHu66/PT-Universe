{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-nexus-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "services": [
    {
      "binding": "RSS_ORBIT",
      "service": "rss-orbit-proxy"
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
