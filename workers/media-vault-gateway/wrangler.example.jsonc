{
  "$schema": "../../workers/pt-universe-api/node_modules/wrangler/config-schema.json",
  "name": "pt-media-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vpc_services": [
    {
      "binding": "INTERNAL_MEDIA",
      "service_id": "__VPC_SERVICE_ID_FROM_CLOUDFLARE__",
      "remote": true
    }
  ]
}
