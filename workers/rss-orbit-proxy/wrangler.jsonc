{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rss-orbit-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "RSS_CACHE"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
